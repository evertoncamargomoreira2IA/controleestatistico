@page "/cadastros/instrumentos"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:view")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Qms.Application.MasterData
@using Qms.Domain.MasterData
@using Qms.Domain.Security
@using Qms.Web.Components.Ui
@inject IInstrumentService Service
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Instrumentos · QMS CEP</PageTitle>
<PageHeader Title="Instrumentos" Breadcrumb="Cadastros" />
@if(error is not null){<div class="alert alert-bad" role="alert">@error</div>}
<div class="toolbar">@if(canManage){<button class="btn" @onclick="New">Novo instrumento</button>}<a class="btn ghost" href="/cadastros">Cadastros</a>
</div>
<Card>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Código</th>
<th>Nome</th>
<th>Tipo</th>
<th>Resolução</th>
<th>Calibração</th>
<th>Ativo</th>
<th>
</th>
</tr>
</thead>
<tbody>@foreach(var item in instruments){<tr>
<td>@item.Code</td>
<td>@item.Name</td>
<td>@item.Type</td>
<td>@(item.Resolution?.ToString("G",System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))??"—")</td>
<td>
<StatusChip Status="@DueStatus(item)" Text="@DueText(item)" />
</td>
<td>@(item.IsActive?"Sim":"Não")</td>
<td>@if(canManage){<button class="btn ghost" @onclick="()=>Edit(item)">Editar</button>}</td>
</tr>}</tbody>
</table>
</div>@if(instruments.Count==0){<EmptyState Text="Nenhum instrumento cadastrado." />}</Card>
@if(open){<aside class="drawer" aria-label="Cadastro de instrumento">
<header class="drawer-header">
<h2>@(selected is null?"Novo instrumento":"Editar instrumento")</h2>
<button class="btn ghost" type="button" aria-label="Fechar" @onclick="()=>open=false">×</button>
</header>
<EditForm class="drawer-form" Model="model" OnValidSubmit="Save">
<div class="field">
<label>Código</label>
<InputText class="form-control" @bind-Value="model.Code" />
</div>
<div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="model.Name" />
</div>
<div class="field">
<label>Tipo</label>
<InputText class="form-control" @bind-Value="model.Type" />
</div>
<div class="field">
<label>Resolução</label>
<InputNumber class="form-control" @bind-Value="model.Resolution" />
</div>
<div class="field">
<label>Vencimento da calibração</label>
<InputDate class="form-control" @bind-Value="due" />
</div>
<div class="field">
<label>Descrição</label>
<InputTextArea class="form-control" @bind-Value="model.Description" />
</div>
<div class="field">
<label>
<InputCheckbox @bind-Value="model.IsActive" /> Ativo</label>
</div>
<footer class="drawer-footer">
<button class="btn ghost" type="button" @onclick="()=>open=false">Cancelar</button>
<button class="btn" type="submit">Salvar</button>
</footer>
</EditForm>
</aside>}
