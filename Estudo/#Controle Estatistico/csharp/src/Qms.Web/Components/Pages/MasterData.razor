@page "/cadastros"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:view")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Qms.Application.MasterData
@using Qms.Domain.MasterData
@using Qms.Domain.Security
@using Qms.Web.Components.Ui
@inject IMasterDataService Service
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Cadastros · QMS CEP</PageTitle>
<PageHeader Title="Cadastros" Breadcrumb="@BreadcrumbText" />
@if (errorMessage is not null) { <div class="alert alert-bad" role="alert">@errorMessage</div> }
@if (successMessage is not null) { <div class="alert alert-ok" role="status">@successMessage</div> }
<div class="toolbar">
<a class="btn ghost" href="/cadastros/instrumentos">Instrumentos</a>
</div>
<div class="master-columns">
    @for (var i = 0; i < columns.Length; i++)
    {
        var index = i;
        <Card Title="@columns[index].Title">
            @if (CanManage && (index == 0 || selected[index - 1] is not null))
            {
                @if (index == 4) { <div class="field">
<label>Código do tooling</label>
<input class="form-control" @bind="newCode" />
</div> }
                <div class="field">
<label>@columns[index].NewLabel</label>
<input class="form-control" @bind="newName[index]" />
</div>
                @if (index == 4) { <div class="field">
<label>Descrição</label>
<textarea class="form-control" @bind="newDescription">
</textarea>
</div> }
                <button class="btn" @onclick="() => CreateAsync(index)">Criar</button>
            }
            @if (items[index].Count == 0) { <EmptyState Text="Nenhum item neste nível." /> }
            @foreach (var item in items[index])
            {
                <div class="master-item @(selected[index]?.Id == item.Id ? "active" : "") @(!item.IsActive ? "inactive" : "")">
<button class="master-select" @onclick="() => SelectAsync(index, item)">@Display(item) @if (!item.IsActive) { <span>(inativo)</span> }</button>
                    @if (CanManage) { <button class="btn ghost" @onclick="() => Edit(item,index)">Editar</button> }
                </div>
            }
        </Card>
    }
</div>
@if (editing && selected[editIndex] is { } entity)
{
    <aside class="drawer" aria-label="Editar cadastro">
<header class="drawer-header">
<h2>Editar @columns[editIndex].Title</h2>
<button class="btn ghost" type="button" aria-label="Fechar" @onclick="Close">×</button>
</header>
        @if (formError is not null) { <div class="alert alert-bad" role="alert">@formError</div> }
        <EditForm class="drawer-form" Model="entity" OnValidSubmit="SaveAsync">
            @if (entity is Tooling tooling) { <div class="field">
<label>Código</label>
<InputText class="form-control" @bind-Value="tooling.Code" />
</div>
<div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="tooling.Name" />
</div>
<div class="field">
<label>Descrição</label>
<InputTextArea class="form-control" @bind-Value="tooling.Description" />
</div> }
            else if (entity is Characteristic characteristic) { <div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="characteristic.Name" />
</div>
<div class="field">
<label>Unidade</label>
<InputText class="form-control" @bind-Value="characteristic.Unit" />
</div>
<div class="field">
<label>Tipo de dado</label>
<InputSelect class="form-control" @bind-Value="characteristic.DataType">
<option value="Continuous">Contínua</option>
<option value="Attribute">Atributo</option>
</InputSelect>
</div>
<div class="field">
<label>LSL</label>
<InputNumber class="form-control" @bind-Value="characteristic.Lsl" />
</div>
<div class="field">
<label>Nominal</label>
<InputNumber class="form-control" @bind-Value="characteristic.Nominal" />
</div>
<div class="field">
<label>USL</label>
<InputNumber class="form-control" @bind-Value="characteristic.Usl" />
</div>
<div class="field">
<label>Tamanho do subgrupo</label>
<InputNumber class="form-control" @bind-Value="characteristic.SubgroupSize" />
</div>
<div class="field">
<label>Tipo de carta</label>
<InputSelect class="form-control" @bind-Value="characteristic.ChartType">
<option value="IMr">I-MR</option>
<option value="XbarR">X̄-R</option>
<option value="XbarS">X̄-S</option>
</InputSelect>
</div>
<p>rev. @characteristic.Revision · @Specification(characteristic)</p> }
            else if (entity is Area area) { <div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="area.Name" />
</div> }
            else if (entity is Product product) { <div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="product.Name" />
</div> }
            else if (entity is Line line) { <div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="line.Name" />
</div> }
            else if (entity is Station station) { <div class="field">
<label>Nome</label>
<InputText class="form-control" @bind-Value="station.Name" />
</div> }
            <div class="field">
<label>
<InputCheckbox @bind-Value="entity.IsActive" /> Ativo</label>
</div>
<footer class="drawer-footer">
<button class="btn ghost" type="button" @onclick="Close">Cancelar</button>
<button class="btn" type="submit">Salvar</button>
</footer>
</EditForm>
</aside>
}
