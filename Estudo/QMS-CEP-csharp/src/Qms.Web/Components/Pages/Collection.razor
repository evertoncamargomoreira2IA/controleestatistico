@page "/coleta"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:view")]
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Qms.Application.Collection
@using Qms.Application.MasterData
@using Qms.Domain.MasterData
@using Qms.Domain.Security
<PageTitle>Coleta · QMS CEP</PageTitle>
<PageHeader Title="Coleta" Breadcrumb="Operação" />
@if (error is not null) { <div class="alert alert-bad" role="alert">@error</div> }
@if (success is not null) { <div class="alert alert-ok collection-toast" role="status">@success</div> }
<div class="collection-toolbar">
<a class="btn ghost" href="/coleta/importar">Importar arquivo</a>
@if (selected[5] is Characteristic characteristic)
{
<a class="btn ghost" href="@TemplateUrl("xlsx", characteristic.Id)">Baixar template XLSX</a>
<a class="btn ghost" href="@TemplateUrl("csv", characteristic.Id)">Baixar template CSV</a>
}
</div>
<div class="collection-levels">
@for (var i = 0; i < labels.Length; i++)
{
    var index = i;
    <label class="field">@labels[index]
    <select class="form-control" value="@(selected[index]?.Id.ToString() ?? "")"
    @onchange="e => SelectAsync(index, e.Value?.ToString())">
    <option value="">Selecione...</option>
    @foreach (var item in items[index])
    {
        <option value="@item.Id">@Display(item)</option>
    }
    </select>
    </label>
}
</div>
@if (selected[5] is Characteristic chosen && chosen.DataType == CharacteristicDataType.Continuous)
{
    <section class="card collection-spec">
    <h2>Especificação · @chosen.Name</h2>
    <p>Unidade: @(chosen.Unit ?? "—") · LSL: @Number(chosen.Lsl) · Nominal: @Number(chosen.Nominal)
    · USL: @Number(chosen.Usl) · n: @chosen.SubgroupSize · Carta: @chosen.ChartType · rev. @chosen.Revision</p>
    </section>
    @if (canCreate)
    {
    <section class="card collection-entry">
    <h2>Novo subgrupo</h2>
    <div class="collection-values">
    @for (var i = 0; i < values.Length; i++)
    {
        var index = i;
        <label class="field">Valor @(index + 1)
        <input class="form-control collection-value" inputmode="decimal" @bind="values[index]"
        @onkeydown="e => Advance(e, index)" @ref="valueRefs[index]" />
        </label>
    }
    </div>
    <div class="collection-fields">
    <label class="field">Instrumento
    <select class="form-control" @bind="instrumentId">
    <option value="">Selecione...</option>
    @foreach (var item in instruments)
    {
        var overdue = item.CalibrationDue is { } due && due < todayLocal;
        <option value="@item.Id" disabled="@overdue">
        @item.Code · @item.Name@(overdue ? " (calibração vencida)" : "")</option>
    }
    </select></label>
    <label class="field">Data e hora <input class="form-control" type="datetime-local" @bind="collectedAt" /></label>
    <fieldset class="shift-field"><legend>Turno</legend><div class="shift-buttons">
    @foreach (var shift in new[] { "T1", "T2", "T3" })
    {
        <button type="button" class="btn @(selectedShift == shift ? "" : "ghost")"
        @onclick="() => selectedShift = shift">@shift</button>
    }
    </div></fieldset>
    <label class="field">Lote <input class="form-control" maxlength="80" @bind="lot" /></label>
    <label class="field collection-note">Observação
    <textarea class="form-control" maxlength="500" @bind="note"></textarea></label>
    </div>
    <button class="btn collection-submit" @onclick="SaveAsync">Registrar subgrupo</button>
    </section>
    }
    <section class="card">
    <h2>Últimos subgrupos</h2>
    <div class="table-wrap"><table><thead><tr><th>Data local</th><th>Valores</th><th>Média</th>
    <th>Amplitude</th><th>Instrumento</th><th>Operador</th><th>Origem</th><th>Estado</th></tr></thead><tbody>
    @foreach (var row in recent)
    {
        var rowValues = row.Measurements.OrderBy(x => x.Position).Select(x => x.Value).ToArray();
        <tr class="@(row.IsExcluded ? "is-excluded" : "")"><td>@LocalTime.Format(row.CollectedAt)</td>
        <td>@string.Join(", ", rowValues.Select(NumberValue))</td>
        <td>@Average(rowValues)</td>
        <td>@Range(rowValues)</td>
        <td>@InstrumentName(row.InstrumentId)</td>
        <td>@operatorNames.GetValueOrDefault(row.OperatorId, row.OperatorId)</td>
        <td><span class="status-chip">@(row.Source == "online" ? "online" : "upload")</span></td>
        <td>@if (row.IsExcluded) { <span>Excluído: @row.ExclusionReason</span> }
        else if (canManage) { <button class="btn ghost" @onclick="() => AskExclude(row.Id)">Excluir</button> }
        else { <span>Ativo</span> }</td></tr>
    }
    @if (recent.Count == 0) { <tr><td colspan="8">Nenhum subgrupo registrado.</td></tr> }
    </tbody></table></div></section>
}
@if (excludeId is not null)
{
    <aside class="drawer" aria-label="Excluir subgrupo"><header class="drawer-header"><h2>Excluir subgrupo</h2>
    <button class="btn ghost" @onclick="CancelExclude">Fechar</button></header>
    <label class="field">Motivo obrigatório
    <textarea class="form-control" maxlength="300" @bind="excludeReason"></textarea></label>
    <footer class="drawer-footer"><button class="btn ghost" @onclick="CancelExclude">Cancelar</button>
    <button class="btn" @onclick="ExcludeAsync">Confirmar exclusão</button></footer></aside>
}
