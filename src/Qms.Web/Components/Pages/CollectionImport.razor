@page "/coleta/importar"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:collection.create")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Qms.Application.Collection
<PageTitle>Importar coleta · QMS CEP</PageTitle>
<PageHeader Title="Importar coleta" Breadcrumb="Coleta" />
@if (error is not null) { <div class="alert alert-bad" role="alert">@error</div> }
@if (batch is not null)
{
    <section class="card"><h2>Importação concluída</h2>
    <p>@batch.RowsImported subgrupos importados; @batch.RowsRejected linhas rejeitadas.</p>
    <a class="btn" href="/coleta">Ir para a coleta</a></section>
}
else
{
    <section class="card"><h2>Arquivo XLSX ou CSV</h2>
    <InputFile OnChange="FileSelected" accept=".xlsx,.csv" />
    <p>Limite: 5 MB.</p></section>
    @if (rows is not null)
    {
        <section class="card"><h2>Prévia de importação</h2>
        <p>@validCount linhas válidas; @rejectedCount linhas com erro.</p>
        <div class="table-wrap"><table><thead><tr><th>Linha</th><th>Característica</th><th>Instrumento</th>
        <th>Data e hora local</th><th>Valores</th><th>Status</th></tr></thead><tbody>
        @foreach (var row in rows)
        {
            <tr class="@(row.IsValid ? "" : "is-excluded")"><td>@row.Line</td>
            <td>@(row.Characteristic?.Name ?? "—")</td><td>@(row.Instrument?.Code ?? "—")</td>
            <td>@(row.CollectedAt is { } date ? LocalTime.Format(date) : "—")</td>
            <td>@string.Join(", ", row.RawValues)</td>
            <td><span class="status-chip">@RowStatus(row)</span></td></tr>
        }
        @if (rows.Count == 0) { <tr><td colspan="6">Nenhuma linha de dados encontrada.</td></tr> }
        </tbody></table></div>
        <button class="btn" disabled="@(validCount == 0 || committing)" @onclick="CommitAsync">
        Confirmar importação das @validCount linhas válidas</button></section>
    }
}
