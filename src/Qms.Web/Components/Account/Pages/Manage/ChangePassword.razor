@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Qms.Infrastructure.Identity
@using Qms.Application.Auditing

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ChangePassword> Logger
@inject IAuditService AuditService

<PageTitle>Alterar senha</PageTitle>

<h3>Alterar senha</h3>
<StatusMessage Message="@message" />
<div class="row">
    <div class="col-xl-6">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" role="alert" />
            <div class="field">
                <label for="Input.OldPassword">Senha atual</label>
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Senha atual" />
                <ValidationMessage For="() => Input.OldPassword" class="validation-message" />
            </div>
            <div class="field">
                <label for="Input.NewPassword">Nova senha</label>
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Nova senha" />
                <ValidationMessage For="() => Input.NewPassword" class="validation-message" />
            </div>
            <div class="field">
                <label for="Input.ConfirmPassword">Confirme a nova senha</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirme a nova senha" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
            </div>
            <button type="submit" class="btn">Atualizar senha</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        hasPassword = await UserManager.HasPasswordAsync(user);
        if (!hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var changePasswordResult = await UserManager.ChangePasswordAsync(user, Input.OldPassword, Input.NewPassword);
        if (!changePasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        user.MustChangePassword = false;
        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            message = $"Erro: {string.Join(", ", updateResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        await AuditService.RecordAsync(user.Id, "user", user.Id, "password.change",
            ip: HttpContext.Connection.RemoteIpAddress?.ToString(), origin: "web");
        Logger.LogInformation("User changed their password successfully.");

        RedirectManager.RedirectToCurrentPageWithStatus("Senha alterada.", HttpContext);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Informe a senha atual.")]
        [DataType(DataType.Password)]
        [Display(Name = "Senha atual")]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Informe a nova senha.")]
        [StringLength(100, ErrorMessage = "A senha deve ter no mínimo 12 caracteres.", MinimumLength = 12)]
        [DataType(DataType.Password)]
        [Display(Name = "Nova senha")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirme a nova senha")]
        [Required(ErrorMessage = "Confirme a nova senha.")]
        [Compare("NewPassword", ErrorMessage = "A confirmação da senha não corresponde.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
